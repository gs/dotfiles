{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.2:cloud",
  "plugin": [
    "@different-ai/opencode-browser",
    "caveman-opencode-plugin@latest"
  ],
  "provider": {
    "ollama": {
      "models": {
        "glm-5.2:cloud": {
          "_launch": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "name": "glm-5.2:cloud"
        },
        "qwen3.5:cloud": {
          "_launch": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "name": "qwen3.5:cloud"
        },
        "gemma4:31b-cloud": {
          "_launch": true,
          "name": "gemma4:31b-cloud"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "quento": {
      "type": "remote",
      "url": "https://staging.quento.app/mcp"
    }
  },
}
