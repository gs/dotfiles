.DS_Store

# Upstream clones, not our code — install.sh clones them fresh
.config/tmux/plugins/

# Generated / build artifacts
.config/opencode/bun.lock
.config/opencode/node_modules/
.config/opencode/package.json
.config/opencode/*.zip
.config/tiny_nvim/lazy-lock.json
.config/tmux/tmux.conf.bak.*

# --- Hyprland (Omarchy): machine-specific + local backups, never track ---
.config/hypr/monitors.lua
.config/hypr/*.lua.bak.*
.config/hypr/*.before-migration-*

# --- SECRETS: never commit these (guards against accidental `git add -A`) ---
# SSH private keys / client config / known hosts
.ssh/
**/id_*
!**/id_*.pub
*.pem
*_pkey
# Credential-bearing app configs
.config/gh/hosts.yml
.config/rclone/
.config/stripe/
.config/ngrok/
.config/github-copilot/
.config/Nextcloud/
.config/herdr/
.netrc
.config/opencode/*.bak
.config/opencode/*.tui-migration.bak
