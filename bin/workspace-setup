#!/bin/bash
# workspace-setup — launch my standard apps onto their workspaces:
#   1: terminal + tmux    2: terminal    8: Nextcloud
#   9: WhatsApp, Signal, Blue    10 (Super+0): browser
#
# Idempotent: anything already running is left alone, so it's safe to re-run.
# Bound to SUPER+SHIFT+GRAVE in hypr/bindings.lua.
#
# Native apps use Hyprland's `[workspace N silent]` exec rule. Chromium webapps
# can't: when a chromium process already exists the launcher delegates to it and
# exits, so the rule's PID tracking misses the window. For those we launch, wait
# for the new window of the right class, and move it by address.

set -u

clients() { hyprctl clients -j; }

has_class() { clients | jq -e --arg s "$1" 'any(.[]; .class | contains($s))' >/dev/null; }

has_foot_on() { clients | jq -e --argjson w "$1" 'any(.[]; .class == "foot" and .workspace.id == $w)' >/dev/null; }

# Launch onto a workspace via exec rule (apps whose process owns the window)
exec_ws() { # <workspace> <command...>
  local ws=$1; shift
  hyprctl dispatch "hl.dsp.exec_cmd('[workspace $ws silent] uwsm-app -- $*')" >/dev/null
}

# Launch, then move the first new window whose class contains <substring>
launch_move() { # <workspace> <class-substring> <command...>
  local ws=$1 sub=$2 before new
  shift 2
  before=$(clients | jq -c --arg s "$sub" '[.[] | select(.class | contains($s)) | .address]')
  setsid -f "$@" >/dev/null 2>&1
  for _ in $(seq 1 50); do
    sleep 0.2
    new=$(clients | jq -r --arg s "$sub" --argjson b "$before" \
      '[.[] | select(.class | contains($s)) | .address] - $b | .[0] // empty')
    if [[ -n $new ]]; then
      hyprctl dispatch "hl.dsp.window.move({ workspace = '$ws', follow = false, window = 'address:$new' })" >/dev/null
      return 0
    fi
  done
  echo "workspace-setup: no '$sub' window appeared" >&2
  return 1
}

# Workspace 1: terminal with tmux (attach to "main" or create it)
has_foot_on 1 || exec_ws 1 "foot -e tmux new-session -A -s main"

# Workspace 2: plain terminal
has_foot_on 2 || exec_ws 2 foot

# Workspace 10 (Super+0): browser
has_class chromium || launch_move 10 chromium uwsm-app -- chromium &

# Workspace 8: Nextcloud webapp. The URL (a private tailnet hostname) stays out
# of this public repo: read it from the machine-local desktop entry instead.
# The chromium webapp's window class contains the URL's hostname.
nc_desktop="$HOME/.local/share/applications/Nextcloud.desktop"
if [[ -f $nc_desktop ]]; then
  nc_url=$(sed -n 's/^Exec=omarchy-launch-webapp //p' "$nc_desktop")
  nc_host=${nc_url#*://}
  nc_host=${nc_host%%/*}
  if [[ -n $nc_host ]]; then
    has_class "$nc_host" || launch_move 8 "$nc_host" omarchy-launch-webapp "$nc_url" &
  fi
fi

# Workspace 9: WhatsApp webapp, Signal, Blue
has_class web.whatsapp || launch_move 9 web.whatsapp omarchy-launch-webapp 'https://web.whatsapp.com/' &
has_class signal || exec_ws 9 signal-desktop
has_class iphonebridge || exec_ws 9 "$HOME/.local/bin/blue-qt"

wait
