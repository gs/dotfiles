#!/bin/bash
# workspace-setup — launch my standard apps onto the FOCUSED monitor's
# workspaces:
#   1: terminal + tmux    2: terminal    3: Agenty    4: Chat
#   8: Nextcloud    9: WhatsApp, Signal    10 (Super+0): browser
#
# The numbers are per monitor, as SUPER+N sees them: Omarchy gives every monitor
# its own block of ten workspace ids (laptop 1-10, next monitor 11-20, ...; see
# default/hypr/monitor-workspaces.lua), so on the monitor in block 1 "8" is 18.
#
# Idempotent: an app already running anywhere is left where it is, so it's safe
# to re-run.
# Bound to SUPER+SHIFT+GRAVE in hypr/bindings.lua.
#
# Native apps use Hyprland's `[workspace N silent]` exec rule. Chromium webapps
# can't: when a chromium process already exists the launcher delegates to it and
# exits, so the rule's PID tracking misses the window. For those we launch, wait
# for the new window of the right class, and move it by address.

set -u

clients() { hyprctl clients -j; }

has_class() { clients | jq -e --arg s "$1" 'any(.[]; .class | contains($s))' >/dev/null; }

has_foot_on() { clients | jq -e --argjson w "$1" 'any(.[]; .class == "foot" and .workspace.id == $w)' >/dev/null; }

# The focused monitor and its block of workspace ids, read from Omarchy's state
# file (block <TAB> connector <TAB> identity). Without it, fall back to 1-10.
TARGET=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
OMARCHY_BLOCKS="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitor-workspaces"
block=0
if [[ -r $OMARCHY_BLOCKS ]]; then
  block=$(awk -F'\t' -v m="$TARGET" '$2 == m { print $1; exit }' "$OMARCHY_BLOCKS")
  block=${block:-0}
fi
ws() { echo $(( block * 10 + $1 )); } # <slot 1-10> -> workspace id

# Launch onto a workspace via exec rule (apps whose process owns the window)
exec_ws() { # <workspace id> <command...>
  local id=$1; shift
  hyprctl dispatch "hl.dsp.exec_cmd('[workspace $id silent] uwsm-app -- $*')" >/dev/null
}

# Launch, then move the first new window whose class contains <substring>
launch_move() { # <workspace id> <class-substring> <command...>
  local id=$1 sub=$2 before new
  shift 2
  before=$(clients | jq -c --arg s "$sub" '[.[] | select(.class | contains($s)) | .address]')
  setsid -f "$@" >/dev/null 2>&1
  for _ in $(seq 1 50); do
    sleep 0.2
    new=$(clients | jq -r --arg s "$sub" --argjson b "$before" \
      '[.[] | select(.class | contains($s)) | .address] - $b | .[0] // empty')
    if [[ -n $new ]]; then
      hyprctl dispatch "hl.dsp.window.move({ workspace = '$id', follow = false, window = 'address:$new' })" >/dev/null
      return 0
    fi
  done
  echo "workspace-setup: no '$sub' window appeared" >&2
  return 1
}

# Hyprland creates a missing workspace on whichever monitor has focus, and
# launching can move focus. Make sure each workspace we filled is on TARGET.
on_target() { # <workspace id>
  local id=$1 on
  for _ in $(seq 1 15); do
    on=$(hyprctl workspaces -j | jq -r --argjson i "$id" '.[] | select(.id == $i) | .monitor')
    [[ -n $on ]] && break
    sleep 0.2
  done
  if [[ -n $on && $on != "$TARGET" ]]; then
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = '$id', monitor = '$TARGET' })" >/dev/null
  fi
}

# Native apps first; they don't touch chromium.
has_foot_on "$(ws 1)" || exec_ws "$(ws 1)" "foot -e tmux new-session -A -s main"
has_foot_on "$(ws 2)" || exec_ws "$(ws 2)" foot
has_class signal || exec_ws "$(ws 9)" signal-desktop

# Chromium windows one at a time, browser first. With no chromium running yet,
# parallel launches race for the profile lock and can end up as two browser
# processes on one profile ("Profile error occurred" windows).
has_class chromium || launch_move "$(ws 10)" chromium uwsm-app -- chromium

# Webapps whose URLs (private tailnet hosts) stay out of this public repo: read
# them from the machine-local desktop entries Omarchy's webapp installer wrote.
# The window class is what Chromium derives from the URL: "chrome-" + host
# (port dropped) + "_" + path with every "/" as "_" + "-Default", e.g.
#   https://box:8448/DEL/dashboard -> chrome-box__DEL_dashboard-Default
# Match the whole class: the host alone is shared (Chat on box:8453/ is
# chrome-box__-Default) and would count as already running.
webapp() { # <slot> <desktop entry name>
  local entry="$HOME/.local/share/applications/$2.desktop" url host path class
  [[ -f $entry ]] || return 0
  url=$(sed -n 's/^Exec=omarchy-launch-webapp //p' "$entry")
  # The installer quotes the URL in Exec=; strip the quotes or the launcher
  # gets a literal "https://..." and opens nothing.
  url=${url#\"}; url=${url%\"}
  [[ -n $url ]] || return 0
  host=${url#*://}; path=/${host#*/}; host=${host%%/*}; host=${host%%:*}
  [[ $url == *://*/* ]] || path=/
  class="chrome-${host}_${path//\//_}-Default"
  has_class "$class" || launch_move "$(ws "$1")" "$class" omarchy-launch-webapp "$url"
}

webapp 3 Agenty
webapp 4 Chat
webapp 8 Nextcloud

has_class web.whatsapp || launch_move "$(ws 9)" web.whatsapp omarchy-launch-webapp 'https://web.whatsapp.com/'

for slot in 1 2 3 4 8 9 10; do on_target "$(ws "$slot")" & done
wait
